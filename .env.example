VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_RAZORPAY_KEY_ID=
# The site's real production domain (no trailing slash), e.g.
# https://trivarastays.com - used to build absolute canonical/Open Graph
# URLs and the generated sitemap.xml (scripts/generate-sitemap.mjs). Falls
# back to window.location.origin at runtime if unset, but the sitemap
# script has no window - set this in the actual build environment (Vercel
# project settings, etc) or the sitemap's <loc> URLs will be wrong.
VITE_SITE_URL=
# Optional: overrides the hardcoded fallback in src/lib/adminAccess.ts.
# This only affects which account gets redirected straight to /admin/dashboard
# after login - actual admin authorization is enforced by the `role='admin'`
# check in Postgres RLS policies, not by this value.
VITE_ADMIN_EMAIL=
